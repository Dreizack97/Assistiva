@model AppUI.Models.StudentModel
@{
    ViewData["Title"] = @Model.StudentId == 0 ? "Agregar estudiante" : "Editar estudiante";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-user-graduate me-2"></i>
                    Información del estudiante
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl col-xl-6 px-4">
    <div class="card">
        <div class="card-header">
            @(Model.StudentId == 0 ? "Agregar" : "Editar") estudiante
        </div>
        <form method="post" asp-area="School" asp-controller="Students" asp-action="Upsert">
            <input asp-for="@Model.StudentId" type="hidden" />
            <input asp-for="@Model.IsActive" type="hidden" />
            <div class="card-body">
                <div class="row gx-3 mb-3">
                    <div class="col-sm-3">
                        <label asp-for="@Model.FirstName" class="small mb-1"></label>
                        <input asp-for="@Model.FirstName" class="form-control form-control-sm" placeholder="Nombre(s)" />
                        <span asp-validation-for="@Model.FirstName" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.PaternalLastName" class="small mb-1"></label>
                        <input asp-for="@Model.PaternalLastName" class="form-control form-control-sm" placeholder="Apellido paterno" />
                        <span asp-validation-for="@Model.PaternalLastName" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.MaternalLastName" class="small mb-1"></label>
                        <input asp-for="@Model.MaternalLastName" class="form-control form-control-sm" placeholder="Apellido materno" />
                        <span asp-validation-for="@Model.MaternalLastName" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.Gender" class="small mb-1"></label>
                        <select asp-for="@Model.Gender" class="form-control form-control-sm">
                            <option value="" disabled selected hidden>Elige una opción</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Masculino">Masculino</option>
                        </select>
                        <span asp-validation-for="@Model.MaternalLastName" class="small text-danger"></span>
                    </div>
                </div>
                <div class="row gx-3 mb-3">
                    <div class="col-sm-3">
                        <label asp-for="@Model.DateOfBirth" class="small mb-1"></label>
                        <input asp-for="@Model.DateOfBirth" class="form-control form-control-sm" />
                        <span asp-validation-for="@Model.DateOfBirth" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.EducationLevel" class="small mb-1"></label>
                        <select asp-for="@Model.EducationLevel" class="form-control form-control-sm">
                            <option value="" selected hidden>Elige una opción</option>
                            <option value="Indefinido">Indefinido</option>
                            <option value="Primaria">Primaria</option>
                            <option value="Secundaria">Secundaria</option>
                            <option value="Preparatoria">Preparatoria</option>
                            <option value="Universidad">Universidad</option>
                            <option value="Maestría">Maestría</option>
                            <option value="Doctorado">Doctorado</option>
                        </select>
                        <span asp-validation-for="@Model.EducationLevel" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.Profession" class="small mb-1"></label>
                        <input asp-for="@Model.Profession" class="form-control form-control-sm" placeholder="Profesión" />
                        <span asp-validation-for="@Model.Profession" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.ProfessionStatus" class="small mb-1"></label>
                        <select asp-for="@Model.ProfessionStatus" class="form-control form-control-sm">
                            <option value="" selected hidden>Elige una opción</option>
                            <option value="Concluida">Concluida</option>
                            <option value="Cursando">Cursando</option>
                            <option value="Pasante">Pasante</option>
                            <option value="Trunca">Trunca</option>
                        </select>
                        <span asp-validation-for="@Model.ProfessionStatus" class="small text-danger"></span>
                    </div>
                </div>
                <div class="row gx-3 mb-3">
                    <div class="col-sm-3">
                        <label asp-for="@Model.MaritalStatus" class="small mb-1"></label>
                        <select asp-for="@Model.MaritalStatus" class="form-control form-control-sm">
                            <option value="" selected hidden>Elige una opción</option>
                            <option value="Soltero(a)">Soltero(a)</option>
                            <option value="Casado(a)">Casado(a)</option>
                            <option value="Divorciado(a)">Divorciado(a)</option>
                            <option value="Viudo(a)">Viudo(a)</option>
                            <option value="Unión libre">Unión libre</option>
                        </select>
                        <span asp-validation-for="@Model.MaritalStatus" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.BloodType" class="small mb-1"></label>
                        <select asp-for="@Model.BloodType" class="form-control form-control-sm">
                            <option value="" selected hidden>Elige una opción</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="Por definir">Por definir</option>
                        </select>
                        <span asp-validation-for="@Model.BloodType" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="@Model.EmailAddress" class="small mb-1"></label>
                        <input asp-for="@Model.EmailAddress" class="form-control form-control-sm" placeholder="Correo electrónico" />
                        <span asp-validation-for="@Model.EmailAddress" class="small text-danger"></span>
                    </div>
                </div>
                <div class="row gx-3 mb-3">
                    <div class="col-sm-3">
                        <label asp-for="@Model.Street" class="small mb-1"></label>
                        <input asp-for="@Model.Street" class="form-control form-control-sm" placeholder="Calle" />
                        <span asp-validation-for="@Model.Street" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.Number" class="small mb-1"></label>
                        <input asp-for="@Model.Number" class="form-control form-control-sm" placeholder="Número" />
                        <span asp-validation-for="@Model.Number" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.Neighborhood" class="small mb-1"></label>
                        <input asp-for="@Model.Neighborhood" class="form-control form-control-sm" placeholder="Colonia" />
                        <span asp-validation-for="@Model.Neighborhood" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.PostalCode" class="small mb-1"></label>
                        <input asp-for="@Model.PostalCode" class="form-control form-control-sm" placeholder="Código postal" />
                        <span asp-validation-for="@Model.PostalCode" class="small text-danger"></span>
                    </div>
                </div>
                <div class="row gx-3 mb-3">
                    <div class="col-sm-3">
                        <label asp-for="@Model.City" class="small mb-1"></label>
                        <input asp-for="@Model.City" class="form-control form-control-sm" placeholder="Ciudad" />
                        <span asp-validation-for="@Model.City" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.State" class="small mb-1"></label>
                        <input asp-for="@Model.State" class="form-control form-control-sm" placeholder="Estado" />
                        <span asp-validation-for="@Model.State" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-3">
                        <label asp-for="@Model.Country" class="small mb-1"></label>
                        <input asp-for="@Model.Country" class="form-control form-control-sm" placeholder="País" />
                        <span asp-validation-for="@Model.Country" class="small text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-sm btn-success me-2">@(Model.StudentId == 0 ? "Agregar" : "Actualizar") estudiante</button>
                <a class="btn btn-sm btn-primary" asp-area="School" asp-controller="Students" asp-action="Index">Regresar</a>
            </div>
        </form>
    </div>
</div>