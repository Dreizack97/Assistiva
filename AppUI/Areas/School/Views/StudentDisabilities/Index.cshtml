@{
    ViewData["Title"] = "Discapacidades del estudiante";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
@section CSS {
    <link href="~/vendor/datatables/datatables.min.css" rel="stylesheet" type="text/css" />
}
<input id="StudentId" value="@ViewBag.StudentId" type="hidden" />
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-graduation-cap me-2"></i>
                    Discapacidades registradas
                </h1>
            </div>
            <div class="col-12 col-xl-auto mb-3">
                <a asp-area="School" asp-controller="StudentDisabilities" asp-action="Upsert" asp-route-StudentId="@ViewBag.StudentId" class="btn btn-sm btn-primary me-2"><i class="fas fa-plus me-2"></i>Agregar discapacidad</a>
                <a asp-area="School" asp-controller="Students" asp-action="Upsert" asp-route-Id="@ViewBag.StudentId" class="btn btn-sm btn-success">Regresar</a>
            </div>
        </div>
    </div>
</header>
<div class="container-fluid px-4">
    <div class="card">
        <div class="card-body">
            <table id="dataTable" class="table table-striped" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Discapacidad</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/vendor/datatables/datatables.min.js"></script>
    <script src="~/js/Views/StudentDisabilities_Index.js"></script>
}