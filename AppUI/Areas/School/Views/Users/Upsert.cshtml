@model AppUI.Models.User.UserModel
@{
    ViewData["Title"] = Model.UserId == 0 ? "Agregar usuario" : "Editar usuario";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-users me-2"></i>
                    Información del usuario
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl col-xl-6 px-4">
    <div class="card">
        <div class="card-header">
            @(Model.UserId == 0 ? "Agregar" : "Editar") usuario
        </div>
        <form method="post" asp-area="School" asp-controller="Users" asp-action="Upsert">
            <input asp-for="@Model.UserId" type="hidden" />
            <div class="card-body">
                <div class="row gx-3 mb-3">
                    <div class="col-sm-4">
                        <label asp-for="@Model.Username" class="small mb-1"></label>
                        <input asp-for="@Model.Username" class="form-control form-control-sm" placeholder="@Model.Username" />
                        <span asp-validation-for="@Model.Username" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="@Model.Email" class="small mb-1"></label>
                        <input asp-for="@Model.Email" class="form-control form-control-sm" placeholder="@Model.Email" />
                        <span asp-validation-for="@Model.Email" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-4">
                        <label asp-for="@Model.RoleId" class="small mb-1"></label>
                        <select asp-for="@Model.RoleId" asp-items="@ViewBag.Roles" class="form-control form-control-sm">
                            <option value="" disabled selected hidden>Elige una opción</option>
                        </select>
                        <span asp-validation-for="@Model.RoleId" class="small text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-sm btn-success me-2">@(Model.UserId == 0 ? "Agregar" : "Actualizar") usuario</button>
                <a class="btn btn-sm btn-primary" asp-area="School" asp-controller="Users" asp-action="Index">Regresar</a>
            </div>
        </form>
    </div>
</div>