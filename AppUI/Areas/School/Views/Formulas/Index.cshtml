@{
    ViewData["Title"] = "Formulas";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
@section CSS {
    <link href="~/vendor/datatables/datatables.min.css" rel="stylesheet" type="text/css" />
    <link href="~/vendor/katex/katex.min.css" rel="stylesheet" type="text/css" />
}
<input id="SubjectId" value="@ViewBag.SubjectId" type="hidden" />
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-plus-minus"></i>
                    Fórmulas
                </h1>
            </div>
            <div class="col-12 col-xl-auto mb-3">
                <a asp-area="School" asp-controller="Formulas" asp-action="Upsert" asp-route-SubjectId="@ViewBag.SubjectId" class="btn btn-sm btn-primary me-2"><i class="fas fa-plus me-2"></i>Agregar fórmula</a>
                <a asp-area="School" asp-controller="Subjects" asp-action="Index" asp-route-SubjectId="@ViewBag.SubjectId" class="btn btn-sm btn-secondary">Regresar</a>
            </div>
        </div>
    </div>
</header>
<div class="container-fluid px-4">
    <div class="card">
        <div class="card-body">
            <table id="dataTable" class="table table-striped align-middle" style="width:100%">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Contenido</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/vendor/datatables/datatables.min.js"></script>
    <script src="~/vendor/katex/katex.min.js"></script>
    <script src="~/vendor/katex/contrib/auto-render.min.js"></script>
    <script src="~/js/Views/Formulas/Index.js"></script>
}