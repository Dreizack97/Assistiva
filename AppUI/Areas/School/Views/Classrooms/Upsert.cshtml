@model AppUI.Models.ClassroomModel
@{
    ViewData["Title"] = @Model.ClassroomId == 0 ? "Agregar grupo" : "Editar grupo";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-chalkboard-user me-2"></i>
                    Información del grupo
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl col-xl-6 px-4">
    <div class="card">
        <div class="card-header">
            @(Model.ClassroomId == 0 ? "Agregar" : "Editar") grupo
        </div>
        <form method="post" asp-area="School" asp-controller="Classrooms" asp-action="Upsert">
            <input asp-for="@Model.ClassroomId" type="hidden" />
            <div class="card-body">
                <div class="row gx-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="@Model.Name" class="small mb-1"></label>
                        <input asp-for="@Model.Name" class="form-control form-control-sm" placeholder="Nombre del grupo" />
                        <span asp-validation-for="@Model.Name" class="small text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="@Model.TeacherId" class="small mb-1"></label>
                        <select asp-for="@Model.TeacherId" asp-items="@ViewBag.Teachers" class="form-control form-control-sm">
                            <option value="" disabled selected hidden>Elige una opción</option>
                        </select>
                        <span asp-validation-for="@Model.TeacherId" class="small text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-sm btn-success me-2">@(Model.ClassroomId == 0 ? "Agregar" : "Actualizar") grupo</button>
                <a class="btn btn-sm btn-primary" asp-area="School" asp-controller="Classrooms" asp-action="Index">Regresar</a>
            </div>
        </form>
    </div>
</div>