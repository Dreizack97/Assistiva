@model AppUI.Models.DisabilityModel
@{
    ViewData["Title"] = @Model.DisabilityId == 0 ? "Agregar discapacidad" : "Editar discapacidad";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-person me-2"></i>
                    Información de la discapacidad
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl col-xl-6 px-4">
    <div class="card">
        <div class="card-header">
            @(Model.DisabilityId == 0 ? "Agregar" : "Editar") discapacidad
        </div>
        <form method="post" asp-area="School" asp-controller="Disabilities" asp-action="Upsert">
            <input asp-for="@Model.DisabilityId" type="hidden" />
            <input asp-for="@Model.IsActive" type="hidden" />
            <div class="card-body">
                <div class="row gx-3 mb-3">
                    <div class="col-sm-12">
                        <label asp-for="@Model.Name" class="small mb-1"></label>
                        <input asp-for="@Model.Name" class="form-control form-control-sm" placeholder="@Model.Name" />
                        <span asp-validation-for="@Model.Name" class="small text-danger"></span>
                    </div>
                </div>
                <div class="row gx-3 mb-3">
                    <div class="col-sm-12">
                        <label asp-for="@Model.Description" class="small mb-1"></label>
                        <textarea asp-for="@Model.Description" class="form-control form-control-sm" placeholder="@Model.Name" rows="5"></textarea>
                        <span asp-validation-for="@Model.Description" class="small text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end">
                <button type="submit" class="btn btn-sm btn-success me-2">@(Model.DisabilityId == 0 ? "Agregar" : "Actualizar") discapacidad</button>
                <a class="btn btn-sm btn-primary" asp-area="School" asp-controller="Disabilities" asp-action="Index">Regresar</a>
            </div>
        </form>
    </div>
</div>