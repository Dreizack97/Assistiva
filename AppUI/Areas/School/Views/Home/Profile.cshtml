@model AppUI.Models.User.UserProfileModel
@{
    ViewData["Title"] = "Mi perfil";
    Layout = "~/Areas/School/Views/Shared/_Layout.cshtml";
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="lni lni-user"></i>
                    Mi perfil
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl px-4 mt-4">
    <div class="row">
        <div class="col-xl-4">
            <div class="card mb-4 mb-xl-0">
                <form method="post" enctype="multipart/form-data" asp-area="School" asp-controller="Home" asp-action="UploadImage">
                    <div class="card-header">
                        Imagen de perfil
                    </div>
                    <div class="card-body text-center">
                        <input asp-for="@Model.UserId" type="hidden" />
                        <input asp-for="@Model.UrlPicture" type="hidden" />
                        <img class="rounded-circle mb-2" style="max-width: 150px; max-height: 150px;" src="@Model.UrlPicture" alt="@Model.Username" />
                        <div class="small font-italic text-muted mb-4">JPG o PNG no mayor a 5 MB</div>
                        <label asp-for="@Model.UrlPicture" class="small mb-1">Seleccionar imagen</label>
                        <input asp-for="@Model.UrlPicture" name="picture" type="file" class="form-control mb-4" />
                    </div>
                    <div class="card-footer d-flex justify-content-end">
                        <button type="submit" class="btn btn-sm btn-primary">Subir imagen</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card mb-4">
                <form method="post" asp-area="School" asp-controller="Home" asp-action="UpdateData">
                    <div class="card-header">
                        Detalles de mi cuenta de usuario
                    </div>
                    <div class="card-body">
                        <input asp-for="@Model.UserId" type="hidden" />
                        <input asp-for="@Model.RoleId" type="hidden" />
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="@Model.Username" class="small mb-1"></label>
                                <input asp-for="@Model.Username" class="form-control form-control-sm" />
                                <span asp-validation-for="@Model.Username" class="small text-danger"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="@Model.Email" class="small mb-1"></label>
                                <input asp-for="@Model.Email" class="form-control form-control-sm" />
                                <span asp-validation-for="@Model.Email" class="small text-danger"></span>
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="@Model.LastPasswordReset" class="small mb-1"></label>
                                <input asp-for="@Model.LastPasswordReset" class="form-control form-control-sm" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="@Model.LastPasswordChange" class="small mb-1"></label>
                                <input asp-for="@Model.LastPasswordChange" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="@Model.CreatedAt" class="small mb-1"></label>
                                <input asp-for="@Model.CreatedAt" class="form-control form-control-sm" readonly />
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="@Model.UpdatedAt" class="small mb-1"></label>
                                <input asp-for="@Model.UpdatedAt" class="form-control form-control-sm" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="card-footer d-flex justify-content-end">
                        <button type="submit" class="btn btn-sm btn-primary">Actualizar datos</button>
                    </div>
                </form>
            </div>            
        </div>
    </div>
</div>