@model AppUI.Models.User.UserProfileModel
@{
    ViewData["Title"] = "Perfil";
    Layout = "~/Areas/Students/Views/Shared/_Layout.cshtml";
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="lni lni-user"></i>
                    Mi perfil
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl px-0 mt-4">
    <div class="row">
        <div class="col-xl-6">
            <div class="row mb-2">
                <div class="col-sm-12">
                    <div class="card mb-4">
                        <form method="post" enctype="multipart/form-data" asp-area="Students" asp-controller="Home"
                            asp-action="UploadImage">
                            <div class="card-header">
                                <label>Imagen de perfil</label>
                            </div>
                            <div class="card-body text-center">
                                <input asp-for="@Model.UserId" type="hidden" />
                                <input asp-for="@Model.UrlPicture" type="hidden" />
                                <img class="rounded-circle mb-2" style="max-width: 150px; max-height: 150px;" src="@Model.UrlPicture" alt="@Model.Username" aria-label="@Model.Username" />
                                <div class="small font-italic text-muted mb-4"><label>JPG o PNG no mayor a 5 MB</label></div>
                                <label asp-for="@Model.UrlPicture" class="small mb-1">Seleccionar imagen</label>
                                <input asp-for="@Model.UrlPicture" name="picture" type="file" class="form-control mb-4" aria-label="Seleccionar imagen" />
                            </div>
                            <div class="card-footer d-flex justify-content-end">
                                <button id="BtnUpload" type="submit" class="btn btn-sm btn-primary">Subir imagen</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12">
                    <div class="card mb-4">
                        <form method="post" asp-area="Students" asp-controller="Home" asp-action="UpdateData">
                            <div class="card-header">
                                <label>Detalles de mi cuenta de usuario</label>
                            </div>
                            <div class="card-body">
                                <input asp-for="@Model.UserId" type="hidden" />
                                <input asp-for="@Model.RoleId" type="hidden" />
                                <div class="row gx-3 mb-3">
                                    <div class="col-sm-6">
                                        <label asp-for="@Model.Username" class="small mb-1"></label>
                                        <input asp-for="@Model.Username" class="form-control form-control-sm" aria-label="@Model.Username" />
                                        <span asp-validation-for="@Model.Username" class="small text-danger" role="alert" aria-live="polite"></span>
                                    </div>
                                    <div class="col-sm-6">
                                        <label asp-for="@Model.Email" class="small mb-1"></label>
                                        <input asp-for="@Model.Email" class="form-control form-control-sm" aria-label="@Model.Email" />
                                        <span asp-validation-for="@Model.Email" class="small text-danger" role="alert" aria-live="polite"></span>
                                    </div>
                                </div>
                                <div class="row gx-3 mb-3">
                                    <div class="col-sm-6">
                                        <label asp-for="@Model.LastPasswordReset" class="small mb-1"></label>
                                        <input asp-for="@Model.LastPasswordReset" class="form-control form-control-sm" aria-label="@Model.LastPasswordReset" readonly />
                                    </div>
                                    <div class="col-sm-6">
                                        <label asp-for="@Model.LastPasswordChange" class="small mb-1"></label>
                                        <input asp-for="@Model.LastPasswordChange" class="form-control form-control-sm" aria-label="@Model.LastPasswordChange" readonly />
                                    </div>
                                </div>
                                <div class="row gx-3 mb-3">
                                    <div class="col-sm-6">
                                        <label asp-for="@Model.CreatedAt" class="small mb-1"></label>
                                        <input asp-for="@Model.CreatedAt" class="form-control form-control-sm" aria-label="@Model.CreatedAt" readonly />
                                    </div>
                                    <div class="col-sm-6">
                                        <label asp-for="@Model.UpdatedAt" class="small mb-1"></label>
                                        <input asp-for="@Model.UpdatedAt" class="form-control form-control-sm" aria-label="@Model.UpdatedAt" readonly />
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-end">
                                <button id="BtnUpdate" type="submit" class="btn btn-sm btn-primary">Actualizar datos</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12">
                    <div class="card mb-4">
                        <form method="post" asp-area="Students" asp-controller="Home" asp-action="ChangePassword">
                            <input asp-for="@Model.UserId" type="hidden" />
                            <div class="card-header">
                                <label>Cambiar contraseña</label>
                            </div>
                            <div class="card-body">
                                <div class="row gx-3 mb-3">
                                    <div class="col-sm-12">
                                        <label asp-for="@Model.ChangePassword!.NewPassword" class="small mb-1"></label>
                                        <input asp-for="@Model.ChangePassword!.NewPassword" class="form-control form-control-sm" placeholder="Nueva contraseña" />
                                        <span asp-validation-for="@Model.ChangePassword!.NewPassword" class="small text-danger" role="alert" aria-live="polite"></span>
                                    </div>
                                </div>
                                <div class="row gx-3 mb-3">
                                    <div class="col-sm-12">
                                        <label asp-for="@Model.ChangePassword!.ConfirmPassword" class="small mb-1"></label>
                                        <input asp-for="@Model.ChangePassword!.ConfirmPassword" class="form-control form-control-sm" placeholder="Nueva contraseña" />
                                        <span asp-validation-for="@Model.ChangePassword!.ConfirmPassword" class="small text-danger" role="alert" aria-live="polite"></span>
                                    </div>
                                </div>
                                <div class="row gx-3 mb-3">
                                    <div class="col-sm-12">
                                        <label asp-for="@Model.ChangePassword!.ActualPassword" class="small mb-1"></label>
                                        <input asp-for="@Model.ChangePassword!.ActualPassword" class="form-control form-control-sm" placeholder="Nueva contraseña" />
                                        <span asp-validation-for="@Model.ChangePassword!.ActualPassword" class="small text-danger" role="alert" aria-live="polite"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-end">
                                <button id="BtnChange" type="submit" class="btn btn-sm btn-primary">Cambiar contraseña</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        @if (Model.Student != null)
        {
            <div class="col-xl-6">
                <div class="card mb-4">
                    <div class="card-header">
                        <label>Detalles de mi cuenta de estudiante</label>
                    </div>
                    <div class="card-body">
                        <input asp-for="@Model.UserId" type="hidden" />
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.FirstName" class="small mb-1"></label>
                                <input asp-for="@Model.Student.FirstName" class="form-control form-control-sm" aria-label="@Model.Student.FirstName" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.PaternalLastName" class="small mb-1"></label>
                                <input asp-for="@Model.Student.PaternalLastName" class="form-control form-control-sm" aria-label="@Model.Student.PaternalLastName" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.MaternalLastName" class="small mb-1"></label>
                                <input asp-for="@Model.Student.MaternalLastName" class="form-control form-control-sm" aria-label="@Model.Student.MaternalLastName" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.Gender" class="small mb-1"></label>
                                <input asp-for="@Model.Student.Gender" class="form-control form-control-sm" aria-label="@Model.Student.Gender" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.DateOfBirth" class="small mb-1"></label>
                                <input asp-for="@Model.Student.DateOfBirth" class="form-control form-control-sm" aria-label="@Model.Student.DateOfBirth" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.EmailAddress" class="small mb-1"></label>
                                <input asp-for="@Model.Student.EmailAddress" class="form-control form-control-sm" aria-label="@Model.Student.EmailAddress" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.EducationLevel" class="small mb-1"></label>
                                <input asp-for="@Model.Student.EducationLevel" class="form-control form-control-sm" aria-label="@Model.Student.EducationLevel" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.Profession" class="small mb-1"></label>
                                <input asp-for="@Model.Student.Profession" class="form-control form-control-sm" aria-label="@Model.Student.Profession" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.ProfessionStatus" class="small mb-1"></label>
                                <input asp-for="@Model.Student.ProfessionStatus" class="form-control form-control-sm" aria-label="@Model.Student.ProfessionStatus" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.MaritalStatus" class="small mb-1"></label>
                                <input asp-for="@Model.Student.MaritalStatus" class="form-control form-control-sm" aria-label="@Model.Student.MaritalStatus" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.BloodType" class="small mb-1"></label>
                                <input asp-for="@Model.Student.BloodType" class="form-control form-control-sm" aria-label="@Model.Student.BloodType" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.Street" class="small mb-1"></label>
                                <input asp-for="@Model.Student.Street" class="form-control form-control-sm" aria-label="@Model.Student.Street" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.Number" class="small mb-1"></label>
                                <input asp-for="@Model.Student.Number" class="form-control form-control-sm" aria-label="@Model.Student.Number" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.Neighborhood" class="small mb-1"></label>
                                <input asp-for="@Model.Student.Neighborhood" class="form-control form-control-sm" aria-label="@Model.Student.Neighborhood" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.City" class="small mb-1"></label>
                                <input asp-for="@Model.Student.City" class="form-control form-control-sm" aria-label="@Model.Student.City" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.PostalCode" class="small mb-1"></label>
                                <input asp-for="@Model.Student.PostalCode" class="form-control form-control-sm" aria-label="@Model.Student.PostalCode" readonly />
                            </div>
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.State" class="small mb-1"></label>
                                <input asp-for="@Model.Student.State" class="form-control form-control-sm" aria-label="@Model.Student.State" readonly />
                            </div>
                        </div>
                        <div class="row gx-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="@Model.Student.Country" class="small mb-1"></label>
                                <input asp-for="@Model.Student.Country" class="form-control form-control-sm" aria-label="@Model.Student.Country" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@section Scripts {
    <script src="~/js/Views/Accessibility/Profile.js"></script>
}