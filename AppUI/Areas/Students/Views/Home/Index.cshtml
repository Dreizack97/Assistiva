@{
    ViewData["Title"] = "Inicio";
    Layout = "~/Areas/Students/Views/Shared/_Layout.cshtml";
}
<div class="text-center">
    <h1 id="WelcomeTag" class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

@if (ViewBag.IsBirthday)
{
    <div class="row">
        <div class="col-md-5">
            <div class="card">
                <div class="card-header">
                    <span class="fw-bold me-2">🎉 !Feliz cumpleaños, @ViewBag.FullName¡ 🎂</span>
                </div>
                <div class="card-body">
                    <div class="row gx-3 mb-3">
                        <span class="mb-2">Hoy es un día muy especial... ¡el tuyo! Desde Instituto Aprende Matemáticas queremos desearte un día lleno de alegría, momentos inolvidables y mucha diversión.</span>
                        <span class="mb-2">Que este nuevo año de vida esté cargado de éxitos, sueños cumplidos y nuevas oportunidades. ¡Eres parte importante de nuestra comunidad y por eso celebramos contigo!</span>
                        <span class="mb-2">¡Disfruta al máximo tu día! 🎁🎈</span>
                        <span>Con cariño, </span>
                        <span class="mb-2">El equipo de Instituto Aprende Matemáticas</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}