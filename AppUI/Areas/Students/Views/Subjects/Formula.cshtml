@model AppUI.Models.Formula.FormulaModel
@{
    ViewData["Title"] = @Model.Name;
    Layout = "~/Areas/Students/Views/Shared/_Layout.cshtml";
}
@section CSS {
    <link href="~/vendor/katex/katex.min.css" rel="stylesheet" type="text/css" />
}
<header class="bg-light mb-4 shadow">
    <div class="container-xl px-4">
        <div class="row align-items-center justify-content-between pt-3">
            <div class="col-auto mb-3">
                <h1 class="card-title text-secondary">
                    <i class="fas fa-plus-minus me-2"></i>
                    @Model.Name
                </h1>
            </div>
        </div>
    </div>
</header>
<div class="container-xl col-xl-12 px-4">
    <div class="row gx-3 mb-3">
        <div class="col-sm-8">
            <div class="card mb-3">
                <div class="card-header">
                    Información
                </div>
                <div class="card-body">
                    <div class="row gx-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="@Model.Name" class="small mb-1"></label>
                            <input asp-for="@Model.Name" class="form-control form-control-sm" readonly />
                            <span asp-validation-for="@Model.Name" class="small text-danger"></span>
                        </div>
                    </div>
                    <div class="row gx-3 mb-3">
                        <div class="col-sm-12">
                            <label asp-for="@Model.Description" class="small mb-1"></label>
                            <textarea asp-for="@Model.Description" class="form-control form-control-sm" rows="5" readonly></textarea>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end">
                    <a class="btn btn-sm btn-primary" asp-area="Students" asp-controller="Subjects" asp-action="Subject" asp-route-Id="@Model.SubjectId">Regresar</a>
                </div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card">
                <div class="card-header">
                    Vista previa de fórmula
                </div>
                <div class="card-body">
                    <div id="formulaPreview" class="d-flex align-items-center justify-content-center" style="min-height: 60px; font-size: 25px">
                        <span class="text-muted">$@Model.Content$</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/vendor/katex/katex.min.js"></script>
    <script src="~/vendor/katex/contrib/auto-render.min.js"></script>
    <script src="~/js/Views/Formulas/Upsert.js"></script>
}