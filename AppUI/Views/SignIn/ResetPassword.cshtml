@model AppUI.Models.User.ResetPasswordModel
@{
	ViewData["Title"] = "Reestablecer contraseña";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 class="fs-4 card-title fw-bold mb-4">Cambiar contraseña</h1>
<form method="post" asp-controller="SignIn" asp-action="ResetPassword" autocomplete="off">
	<input asp-for="RecoveryCode" type="hidden" />
	<div class="mb-3">
		<label asp-for="@Model.NewPassword" class="mb-2 text-muted"></label>
		<div class="input-group">
			<span class="input-group-text"><i class="fas fa-key"></i></span>
			<input asp-for="@Model.NewPassword" class="form-control" required autofocus />
		</div>
		<span asp-validation-for="@Model.NewPassword" class="small text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="@Model.ConfirmPassword" class="mb-2 text-muted"></label>
		<div class="input-group">
			<span class="input-group-text"><i class="fas fa-key"></i></span>
			<input asp-for="@Model.ConfirmPassword" class="form-control" required />
		</div>
		<span asp-validation-for="@Model.ConfirmPassword" class="small text-danger"></span>
	</div>
	<div class="col text-center">
		<button type="submit" class="btn btn-primary ms-auto">Cambiar contraseña</button>
	</div>
</form>