@model AppUI.Models.User.ResetPasswordModel
@{
	ViewData["Title"] = "Reestablecer contraseña";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<input id="Instructions" type="hidden" value="Cambio de contraseña. Puedes utilizar comandos de voz para completar el formulario:
        Di 'Contraseña', seguido de tu nueva clave de acceso.
        Di 'Confirmar contraseña', seguido de tu nueva clave de acceso.
		Di 'Cambiar contraseña', para cambiar tu contraseña.
    Comandos adicionales:
        • «Leer página» - Hacer que el lector de pantalla lea el contenido actual;
        • «Ayuda» - Repetir estas instrucciones." />
<h1 class="fs-4 card-title fw-bold mb-4">Cambiar contraseña</h1>
<form method="post" asp-controller="SignIn" asp-action="ResetPassword" autocomplete="off">
	<input asp-for="RecoveryCode" type="hidden" />
	<div class="mb-3">
		<label asp-for="@Model.NewPassword" class="mb-2 text-muted"></label>
		<div class="input-group">
			<span class="input-group-text" aria-hidden="true"><i class="fas fa-key"></i></span>
			<input asp-for="@Model.NewPassword" class="form-control" required autofocus aria-required="true" aria-label="@Model.NewPassword" aria-describedby="@Model.NewPassword" />
		</div>
		<span asp-validation-for="@Model.NewPassword" class="small text-danger" role="alert" aria-live="assertive"></span>
	</div>
	<div class="mb-3">
		<label asp-for="@Model.ConfirmPassword" class="mb-2 text-muted"></label>
		<div class="input-group">
			<span class="input-group-text" aria-hidden="true"><i class="fas fa-key"></i></span>
			<input asp-for="@Model.ConfirmPassword" class="form-control" required aria-required="true" aria-label="@Model.ConfirmPassword" aria-describedby="@Model.ConfirmPassword" />
		</div>
		<span asp-validation-for="@Model.ConfirmPassword" class="small text-danger" role="alert" aria-live="assertive"></span>
	</div>
	<div class="col text-center">
		<button id="BtnChange" type="submit" class="btn btn-primary ms-auto" aria-label="Botón 'Cambiar contraseña'">Cambiar contraseña</button>
	</div>
</form>
@section Scripts {
	<script src="~/js/Views/Accessibility/SignIn/ResetPassword.js"></script>
}