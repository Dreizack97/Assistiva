@model AppUI.Models.User.ForgotPasswordModel
@{
	ViewData["Title"] = "¿Olvidaste tu contraseña?";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<h1 class="fs-4 card-title fw-bold mb-4">¿Olvidaste tu contraseña?</h1>
<form method="post" asp-controller="SignIn" asp-action="ForgotPassword" autocomplete="off">
	<div class="mb-3">
		<label asp-for="@Model.Email" class="mb-2 text-muted"></label>
		<div class="input-group">
			<span class="input-group-text" aria-hidden="true"><i class="fas fa-user"></i></span>
			<input asp-for="@Model.Email" class="form-control" required autofocus aria-required="true" aria-labelledby="@Model.Email" aria-describedby="@Model.Email" />
		</div>
		<span asp-validation-for="@Model.Email" class="small text-danger" role="alert" aria-live="assertive"></span>
	</div>
	<div class="col text-center">
		<button type="submit" class="btn btn-primary ms-auto" aria-label="Enviar enlace">Enviar enlace</button>
	</div>
</form>